{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "scheduler",
  "version": "0.1.3",
  "description": "Schedule prompts in existing ChatGPT/Codex desktop and Claude sessions with capability-aware setup.",
  "author": {
    "name": "JALA"
  },
  "repository": "https://github.com/Atnic/jala-agent-plugins",
  "homepage": "https://github.com/Atnic/jala-agent-plugins/tree/main/scheduler",
  "keywords": [
    "scheduler",
    "sessions",
    "automation",
    "agent-skills"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
